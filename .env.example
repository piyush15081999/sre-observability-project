# Copy this file to .env and replace the password before starting Compose.
# This template may be committed; real credentials belong only in ignored .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-local-password
# Optional legacy /test routes; /api/error and /api/slow are always registered.
ENABLE_TRAFFIC_TEST_ENDPOINTS=false
