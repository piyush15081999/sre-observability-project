{
  "id": null,
  "uid": "sre-flask-service-overview",
  "title": "SRE - Flask Service Overview",
  "description": "Local Flask service monitoring. Excludes /health and /metrics; five-minute rolling calculations. Availability measures non-5xx responses, not uptime. Rolling 30-day SLO and error budget panels use available retained history.",
  "tags": [
    "sre",
    "flask",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "description": "User API requests per second, summed across methods and endpoints; five-minute rolling rate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Requests / second",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[5m]))",
          "legendFormat": "Request rate",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx error percentage",
      "description": "Percentage of user API requests returning HTTP 5xx over five minutes. No traffic means no data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "HTTP 5xx (%)",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * ((sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\",status=~\"5..\"}[5m])) or (0 * sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[5m])))) / (sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[5m])) > 0))",
          "legendFormat": "HTTP 5xx error percentage",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 response latency",
      "description": "Estimated 95th percentile of user API request durations over five minutes, converted from seconds to milliseconds.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Latency (ms)",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[5m])))",
          "legendFormat": "P95 response latency",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "title": "Availability SLI",
      "description": "Request-based availability: percentage of user API requests with non-5xx responses over five minutes. Includes 4xx as available. No traffic means no data. Objective: 99.9%.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Availability (%)",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - ((sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\",status=~\"5..\"}[5m])) or (0 * sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[5m])))) / (sum(rate(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[5m])) > 0)))",
          "legendFormat": "Availability SLI",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "title": "Observed availability (30d lookback; may be partial)",
      "description": "PROVISIONAL available-history calculation, not a completed 30-day SLO result. See SRE - Flask Availability SLO for history-gated results. Includes 4xx as available; no traffic means no data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Availability (%)",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * ((sum(increase(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\",status!~\"5..\"}[30d])) or (0 * sum(increase(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[30d])))) / (sum(increase(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[30d])) > 0))",
          "legendFormat": "Observed availability (may be partial)",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(99.9)",
          "legendFormat": "SLO target 99.9%",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 6,
      "title": "Observed budget consumed (30d lookback; may be partial)",
      "description": "100 × 30-day 5xx requests / (0.001 × all eligible requests). 100% exhausts the 99.9% SLO budget; values above 100% show overspend. Partial history until 30 days accumulate.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Budget consumed (%)",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * ((sum(increase(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\",status=~\"5..\"}[30d])) or (0 * sum(increase(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[30d])))) / (0.001 * (sum(increase(flask_http_requests_total{job=\"flask-api\",endpoint!=\"/health\",endpoint!=\"/metrics\"}[30d])) > 0)))",
          "legendFormat": "Observed budget consumed (may be partial)",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    }
  ]
}
