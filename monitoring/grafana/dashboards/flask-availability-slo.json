{
  "id": null,
  "uid": "sre-flask-availability-slo",
  "title": "SRE - Flask Availability SLO",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "sre",
    "slo",
    "flask"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Measurement policy",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Objective: 99.9% non-5xx eligible requests over a rolling 30-day window.** Excludes `/health` and `/metrics`; includes 4xx and simulation traffic.\n\n**PARTIAL / UNVERIFIED until the history status confirms 30 days of valid monitoring observations.** Full-window result panels are hidden until then. Preview panels use available data and are not completed 30-day SLO results. Scrape-based checks do not prove exact request accounting; outages between scrapes, counter disappearance, and unsampled requests remain limitations."
      }
    },
    {
      "id": 2,
      "title": "30-day history status",
      "type": "stat",
      "description": "Requires 30 days of continuously valid 15-second rule observations, starting when installed. No data is unverified.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flask:slo_window_ready",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "PARTIAL / UNVERIFIED",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PARTIAL / UNVERIFIED",
                  "color": "orange"
                },
                "1": {
                  "text": "30d observation check passed",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Recorded history coverage",
      "type": "stat",
      "description": "Fraction of required 172800 observation samples recorded. Coverage alone does not establish scrape success or readiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flask:slo_observation_coverage_percent:30d",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "noValue": "Not verified / no traffic",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
